{
    "editor.fontFamily": "'Maple Mono','Fira Code', Consolas, 'Courier New', monospace",
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "editor.fontSize": 16,
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    }
}